{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "target": "ES2022",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["ESNext"],
        "strict": true,
        "esModuleInterop": true,
        "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "prisma.config.ts"]
}
